# ─── Foodvisor — example environment variables ───
# Copy to .env.local (it is in .gitignore and NEVER pushed to GitHub):
#   cp .env.example .env.local
# Then paste your values. Both Vite and Express (server.ts) pick up .env.local.
#
# IMPORTANT:
# - VITE_* keys end up in the client JS bundle (anyone can see them in DevTools).
#   So only PUBLIC keys belong here (Supabase publishable/anon, Google Client ID).
# - The private GEMINI_API_KEY (no VITE_ prefix) is read ONLY by the server (server.ts / api/*).
#   Never put it in the client. Local client-side AI uses VITE_GEMINI_API_KEY
#   (restrict it in Google Cloud Console: HTTP referrers + only Generative Language API).

# ─── Supabase (required for cloud sync) ───
# Get it at: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx_your_public_key

# Compatibility aliases (you may duplicate the same values)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx_your_public_key

# Server-only (Express / Vercel Serverless). Optional, falls back to VITE_*.
# SUPABASE_URL=https://xyzcompany.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx_your_public_key
# SUPABASE_ANON_KEY=sb_publishable_xxx_your_public_key
# ⚠️ NEVER write SERVICE_ROLE_KEY here and NEVER commit it to the repo.

# ─── Gemini AI ───
# Client key (visible in the browser — restrict referrers in Google Cloud Console).
# Get it at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=AIza_your_browser_key

# Server key (secret, Node only: server.ts reads process.env.GEMINI_API_KEY).
# On Vercel it is set in Project Settings → Environment Variables.
# GEMINI_API_KEY=AIza_your_server_key

# ─── Google Fit / OAuth Client ID (public, visible in the browser — that is fine) ───
# Get it at: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=1234567890-xxx.apps.googleusercontent.com

# ─── Misc (set automatically by hosts, do not touch manually) ───
# VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL — set by Vercel itself
# NODE_ENV=development
